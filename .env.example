# ─── LLM Backend ────────────────────────────────────────────────
# LLM 呼叫全部走本機 `claude` CLI（Claude Code），計入 Claude Code 訂閱額度，
# 不需要任何雲端 API key。需求：本機已安裝並登入 `claude`。

# Embedding model（RAG 用，本機 sentence-transformers，不需要 API key）
EMBEDDING_MODEL=BAAI/bge-m3                  # multilingual, good for zh+en

# ─── Discord ────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=                            # optional: restrict to one server
DISCORD_OWNER_USER_ID=                       # 你的 Discord user ID（右鍵自己的名字 → 複製使用者 ID）

# Scheduler — 定時排程報告（08:30 盤前 / 12:00 盤中 / 14:30 收盤後）
SCHEDULE_REPORT_CHANNEL_ID=                  # 排程報告發送的頻道 ID（右鍵頻道 → 複製頻道 ID）
SCHEDULE_ENABLED=true                        # 設為 false 可關閉排程
SCHEDULE_USER_ID=0                           # 排程使用的系統 user ID，勿修改

# Channel allowlist — bot 只在指定頻道回應，留空則所有頻道都回應
ALLOWED_CHANNEL_IDS=                         # 多個頻道用逗號分隔，例如: 123456,789012

# ─── Storage ────────────────────────────────────────────────────
DB_PATH=data/market_agent.db                 # local SQLite file (replaces Postgres + Redis)

# ─── News & Data Sources ────────────────────────────────────────
NEWSAPI_KEY=                                 # optional, https://newsapi.org
GNEWS_API_KEY=                               # optional, https://gnews.io

# ─── Gmail OAuth ────────────────────────────────────────────────
# 1. Google Cloud Console → 建立 OAuth 2.0 用戶端 → 下載 JSON → 重新命名為下方檔名
# 2. 執行 `python scripts/gmail_auth.py` 完成瀏覽器授權 → 產生 token 檔
GMAIL_CREDENTIALS_FILE=gmail_credentials.json
GMAIL_TOKEN_FILE=gmail_token.json

# ─── App Settings ───────────────────────────────────────────────
LOG_LEVEL=INFO
MARKET=TW                                    # TW | US | HK
MAX_NEWS_PER_RUN=30
NEWS_LOOKBACK_HOURS=24
SESSION_TTL_SECONDS=3600                     # session expiry (seconds)
